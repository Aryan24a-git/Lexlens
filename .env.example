# --- LLM (Groq) ---
GROQ_API_KEY=
LLM_MODEL_MAIN=llama-3.3-70b-versatile
LLM_MODEL_FAST=llama-3.1-8b-instant
LLM_MODEL_DEEP=llama-3.3-70b-versatile

# --- Limits ---
MAX_CLAUSES_PER_REQUEST=600
MAX_BODY_BYTES=2000000
LLM_TIMEOUT_MS=55000

# --- Rate limiting (optional in dev) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Flags ---
DEMO_MODE=0
DEBUG_PROMPTS=0
NEXT_PUBLIC_APP_NAME=LexLens
